      {"a": "GOOGL", "b": "GOOG",  "ratio": 1,    "kind": "share_class", "note": "Alphabet Class A (voting) vs Class C (non-voting)"},
      {"a": "BRK-A", "b": "BRK-B", "ratio": 1500, "kind": "share_class", "note": "Berkshire A converts into 1500 B"},
      {"a": "FOXA",  "b": "FOX",   "ratio": 1,    "kind": "share_class", "note": "Fox Class A (non-voting) vs Class B (voting)"},
      {"a": "NWSA",  "b": "NWS",   "ratio": 1,    "kind": "share_class", "note": "News Corp Class A vs Class B"},
      {"a": "LBRDK", "b": "LBRDA", "ratio": 1,    "kind": "share_class", "note": "Liberty Broadband C vs A"},
      {"a": "UAA",   "b": "UA",    "ratio": 1,    "kind": "share_class", "note": "Under Armour A vs C"},
      {"a": "LEN",   "b": "LEN-B", "ratio": 1,    "kind": "share_class", "note": "Lennar Class A vs B"},
      {"a": "BF-B",  "b": "BF-A",  "ratio": 1,    "kind": "share_class", "note": "Brown-Forman B vs A"},
      {"a": "HEI",   "b": "HEI-A", "ratio": 1,    "kind": "share_class", "note": "HEICO common vs Class A"},
      {"a": "Z",     "b": "ZG",    "ratio": 1,    "kind": "share_class", "note": "Zillow Class C vs Class A"},
      {"a": "MOG-A", "b": "MOG-B", "ratio": 1,    "kind": "share_class", "note": "Moog Class A vs B"},
      {"a": "SPY",   "b": "IVV",   "ratio": 1,    "kind": "etf_twin",    "note": "S&P 500 ETFs (price levels differ; ratio is recalibrated)"},
      {"a": "VOO",   "b": "IVV",   "ratio": 1,    "kind": "etf_twin",    "note": "S&P 500 ETFs"},
      {"a": "QQQ",   "b": "QQQM",  "ratio": 1,    "kind": "etf_twin",    "note": "Nasdaq-100 ETFs"},
      {"a": "GLD",   "b": "IAU",   "ratio": 1,    "kind": "etf_twin",    "note": "Physical gold trusts"},
